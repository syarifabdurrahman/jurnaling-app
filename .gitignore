android/app/google-services.json
ios/Runner/GoogleService-Info.plist

# App distribution certificates
*.cert
*.certificate
*.key

# User-specific sensitive data
user_data.json
local_config.json
*.local.dart

# Drift database generated files (only include .dart files)
lib/database/database.g.dart

